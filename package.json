{
  "name": "ecossistema-inovacao",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Sistema de Gestão do Ecossistema de Inovação — Centro de Inovação",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:migrar": "node scripts/migrar.mjs",
    "db:semear": "node scripts/semear.mjs",
    "db:senha-app": "node scripts/senha-app-web.mjs",
    "db:resetar": "./scripts/resetar.sh",
    "db:testar": "node scripts/testar-banco.mjs",
    "db:testar:bash": "./scripts/testar-banco.sh",
    "test": "npm run test:dominio && npm run test:integracao",
    "test:dominio": "node --import ./testes/registrar-alias.mjs --test \"testes/dominio/*.test.js\"",
    "test:integracao": "node --import ./testes/registrar-alias.mjs --test \"testes/integracao/*.test.js\"",
    "db:migrar:bash": "./scripts/migrar.sh"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.1.0",
    "next": "14.2.35",
    "pg": "^8.23.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35"
  }
}
