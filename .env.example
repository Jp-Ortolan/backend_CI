# =============================================================================
# Copie para .env.local e preencha. O .env.local NÃO vai para o Git.
#
# Local:      valores impressos pelo "supabase start"
# Produção:   painel do Supabase -> Project Settings -> API
# =============================================================================

# --- Supabase (públicas, expostas no navegador) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=cole-a-anon-key-aqui

# --- Supabase (SECRETA — só no servidor, nunca com prefixo NEXT_PUBLIC_) ---
# Ignora RLS. Usada apenas pela função de check-in público, que valida o
# qr_token antes de gravar a presença.
SUPABASE_SERVICE_ROLE_KEY=cole-a-service-role-key-aqui

# --- Conexão direta com o banco (migrations e scripts de teste) ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- Aplicação ---
# Base usada para montar a URL do QR Code de cada reunião.
NEXT_PUBLIC_APP_URL=http://localhost:3000
