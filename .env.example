# =============================================================================
# Copie para .env.local e preencha. O .env.local NUNCA vai para o Git.
#
# Local:    o Postgres da sua máquina ou o container do Docker
# Railway:  aba "Variables" do serviço Postgres -> DATABASE_URL
# =============================================================================

# --- Banco ---
# Migrations e seeds rodam com o usuário dono (o "postgres" que o Railway cria).
# A APLICAÇÃO deve conectar com o papel app_web, que NÃO é dono das tabelas —
# é isso que faz o RLS valer de verdade. Ver docs/03-ambientes.md.
DATABASE_URL=postgresql://app_web:SENHA_DO_APP_WEB@localhost:5432/ecossistema

# Usada só por scripts de migration e teste, com o usuário dono:
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/ecossistema

DB_MAX_CONEXOES=10

# --- Aplicação ---
# Base usada para montar a URL do QR Code e o link de recuperação de senha.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- E-mail (recuperação de senha) ---
# Sem provedor configurado, o link é impresso no terminal do servidor.
# O fluxo funciona e é testável assim; plugue o provedor quando houver conta.
# EMAIL_PROVEDOR=resend
# RESEND_API_KEY=
# EMAIL_REMETENTE=Ecossistema de Inovação <nao-responda@seudominio.br>
