# =============================================================================
# Copie para .env.local e preencha. O .env.local NUNCA vai para o Git.
#
# Local:    o Postgres da sua máquina ou o container do Docker
# Railway:  aba "Variables" do serviço Postgres -> DATABASE_URL
# =============================================================================

# --- Banco ---
# Migrations e seeds rodam com o usuário dono (o "postgres" que o Railway cria).
# A APLICAÇÃO deve conectar com o papel app_web, que NÃO é dono das tabelas —
# é isso que faz o RLS valer de verdade. Ver docs/03-ambientes.md.
DATABASE_URL=postgresql://app_web:SENHA_DO_APP_WEB@localhost:5432/ecossistema

# Usada só por scripts de migration e teste, com o usuário dono:
DATABASE_URL_ADMIN=postgresql://postgres:postgres@localhost:5432/ecossistema

DB_MAX_CONEXOES=10

# --- Front-end ---
# Este projeto é só back-end. O endereço abaixo é o do FRONT e serve para três
# coisas: liberar a origem no CORS, montar a URL dentro do QR Code e montar o
# link de recuperação de senha. (O nome antigo, NEXT_PUBLIC_APP_URL, ainda é
# aceito como reserva.)
URL_FRONTEND=http://localhost:3000

# O cookie de sessão é httpOnly e sameSite=lax, que basta quando front e API
# ficam sob o mesmo domínio. Em domínios diferentes o navegador só manda o
# cookie com sameSite=none — ligue com 1, e só com HTTPS dos dois lados.
COOKIE_CROSS_SITE=0

# --- Armazenamento de documentos ---
# Hoje existe um adaptador só: os bytes ficam no próprio PostgreSQL, na tabela
# documento_conteudo. O porquê está no cabeçalho da migration 004; o contrato
# para escrever um adaptador de S3/R2 está em
# src/infraestrutura/armazenamento/porta.js.
ARMAZENAMENTO=postgres

# 20 MB. Cabe relatório digitalizado; não cabe vídeo.
UPLOAD_LIMITE_BYTES=20971520

# --- E-mail (recuperação de senha) ---
# Sem provedor configurado, o link é impresso no terminal do servidor.
# O fluxo funciona e é testável assim; plugue o provedor quando houver conta.
# EMAIL_PROVEDOR=resend
# RESEND_API_KEY=
# EMAIL_REMETENTE=Ecossistema de Inovação <nao-responda@seudominio.br>
